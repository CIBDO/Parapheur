APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# En local avec `php artisan serve`, préférer :
# APP_URL=http://localhost:8000
# (requis pour que les URLs signées ONLYOFFICE restent valides)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Durée de vie des tokens API Sanctum (minutes). Défaut : 8 h.
SANCTUM_EXPIRATION=480

# Identité (local | ldap | sso) — ldap/sso préparés, non branchés. Voir docs/identity.md
IDENTITY_DRIVER=local

# URLs signées anti-rejeu (minutes / usages)
SIGNED_URL_DOWNLOAD_TTL=15
SIGNED_URL_STREAM_TTL=15
SIGNED_URL_ONLYOFFICE_TTL=30
SIGNED_URL_STREAM_MAX_USES=12
SIGNED_URL_ONLYOFFICE_MAX_USES=8

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dgtcp.local"
MAIL_FROM_NAME="e-Parapheur DGTCP"
# Pour un vrai SMTP : MAIL_MAILER=smtp + host/port/credentials

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=
VITE_MAPBOX_ACCESS_TOKEN=
# Démos Vuexy MSW (désactivé par défaut) :
# VITE_ENABLE_FAKE_API=true

# ONLYOFFICE Document Server (Temps 2 — édition collaborative)
# Voir docs/onlyoffice.md et docker-compose.yml
ONLYOFFICE_ENABLED=false
ONLYOFFICE_URL=http://localhost:8080
# URL Docs vue depuis Laravel (callback download). Vide = ONLYOFFICE_URL.
# ONLYOFFICE_INTERNAL_URL=http://localhost:8080
# URL publique Laravel vue depuis le conteneur Docs :
ONLYOFFICE_APP_URL=http://host.docker.internal:8000
# Secret JWT (≥ 32 caractères). Générer : php artisan onlyoffice:generate-jwt-secret
ONLYOFFICE_JWT_SECRET=
# Rotation douce : ONLYOFFICE_JWT_SECRET_PREVIOUS=
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_JWT_TTL=3600
ONLYOFFICE_FILE_URL_TTL=30
