APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Local : true. Production : toujours false.
APP_DEBUG=true
APP_URL=http://localhost

# En local avec `php artisan serve`, préférer :
# APP_URL=http://localhost:8000
# (requis pour que les URLs signées ONLYOFFICE restent valides)

# Origines CORS autorisées (séparées par des virgules). Défaut = APP_URL.
# CORS_ALLOWED_ORIGINS="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Local : debug. Production : warning ou error.
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Aligner sur AUTH_IDLE_TIMEOUT (minutes d'inactivité).
SESSION_LIFETIME=30
# Production : true recommandé.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# SAE — préservation (local durci ou S3 Object Lock)
ARCHIVES_DRIVER=local
ARCHIVES_ROOT=
ARCHIVES_BUCKET=
ARCHIVES_REPLICA_DRIVER=local
ARCHIVES_REPLICA_ROOT=
ARCHIVES_REPLICA_BUCKET=
ARCHIVES_OBJECT_LOCK=false
ARCHIVES_AUTO_SIP_ON_ACCEPT=false
ARCHIVES_FORMAT_MIGRATION_ENABLED=true
ARCHIVES_GS_BINARY=gs
ARCHIVES_SOFFICE_BINARY=soffice

QUEUE_CONNECTION=database

# Déconnexion après inactivité (minutes). 0 = désactivé.
AUTH_IDLE_TIMEOUT=30
# Même valeur côté SPA (Vite).
VITE_AUTH_IDLE_TIMEOUT_MINUTES=30

# MFA TOTP optionnel (désactivé par défaut).
AUTH_MFA_ENABLED=false

# Antivirus : heuristic | null | clamav | http
ANTIVIRUS_DRIVER=heuristic
# CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# ANTIVIRUS_HTTP_URL=
# ANTIVIRUS_HTTP_TOKEN=

# Durée de vie absolue des tokens API Sanctum (minutes). Défaut : 8 h.
SANCTUM_EXPIRATION=480

# Identité (local | ldap | sso) — ldap/sso préparés, non branchés. Voir docs/identity.md
IDENTITY_DRIVER=local

# URLs signées anti-rejeu (minutes / usages)
SIGNED_URL_DOWNLOAD_TTL=15
SIGNED_URL_STREAM_TTL=15
SIGNED_URL_ONLYOFFICE_TTL=120
SIGNED_URL_STREAM_MAX_USES=12
SIGNED_URL_ONLYOFFICE_MAX_USES=40

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@dgtcp.local"
MAIL_FROM_NAME="e-Parapheur DGTCP"
# Pour un vrai SMTP : MAIL_MAILER=smtp + host/port/credentials

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=
VITE_MAPBOX_ACCESS_TOKEN=
# Démos Vuexy MSW — UNIQUEMENT en local (jamais en production) :
# pnpm run msw:init && VITE_ENABLE_FAKE_API=true
# VITE_ENABLE_FAKE_API=true

# Entête institutionnelle réunions / CR (modifiable aussi dans le document généré)
# MEETINGS_LETTERHEAD_MINISTRY_1="MINISTÈRE DE L'ÉCONOMIE"
# MEETINGS_LETTERHEAD_MINISTRY_2="ET DES FINANCES"
# MEETINGS_LETTERHEAD_DIRECTION_1="DIRECTION GÉNÉRALE DU TRÉSOR"
# MEETINGS_LETTERHEAD_DIRECTION_2="ET DE LA COMPTABILITÉ PUBLIQUE"
# MEETINGS_LETTERHEAD_REPUBLIC="RÉPUBLIQUE DU MALI"
# MEETINGS_LETTERHEAD_MOTTO="Un Peuple - Un But - Une Foi"

# ONLYOFFICE Document Server (Temps 2 — édition collaborative)
# Voir docs/onlyoffice.md et docker-compose.yml
ONLYOFFICE_ENABLED=false
ONLYOFFICE_URL=http://localhost:8080
# URL Docs vue depuis Laravel (callback download). Vide = ONLYOFFICE_URL.
# ONLYOFFICE_INTERNAL_URL=http://localhost:8080
# URL publique Laravel vue depuis le conteneur Docs :
ONLYOFFICE_APP_URL=http://host.docker.internal:8000
# Secret JWT (≥ 32 caractères). Générer : php artisan onlyoffice:generate-jwt-secret
ONLYOFFICE_JWT_SECRET=
# Rotation douce : ONLYOFFICE_JWT_SECRET_PREVIOUS=
ONLYOFFICE_JWT_HEADER=Authorization
ONLYOFFICE_JWT_TTL=3600
ONLYOFFICE_FILE_URL_TTL=30
